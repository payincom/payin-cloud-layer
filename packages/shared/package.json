{
  "name": "@payin/shared",
  "version": "0.1.0-local",
  "description": "PayIn Shared - Common utilities and types",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build && tsc-alias",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsc-alias": "^1.8.16"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./checkout": {
      "import": "./dist/checkout/index.js",
      "require": "./dist/checkout/index.js",
      "types": "./dist/checkout/index.d.ts"
    }
  }
}
