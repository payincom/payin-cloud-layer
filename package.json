{
  "name": "@payin/cloud-layer",
  "version": "0.1.0-local",
  "private": true,
  "type": "module",
  "description": "PayIn Cloud overlay layer over PayIn Open shared payment core",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --build --pretty false",
    "test": "vitest run",
    "verify": "npm run type-check && npm run build && npm test",
    "start": "node dist/src/server.js",
    "test:e2e:deployed": "node scripts/deployed-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/payincom/payin-cloud-layer.git"
  },
  "bugs": {
    "url": "https://github.com/payincom/payin-cloud-layer/issues"
  },
  "homepage": "https://github.com/payincom/payin-cloud-layer#readme",
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.12.19"
  }
}
